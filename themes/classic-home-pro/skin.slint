// Standalone Level 3 Programmable Skin: Classic Home Pro (.slint + .rhai).
// Peer rewrite of the classic RustTV home screen sharing zero elements with home.slint.
import { RustTV } from "@rusttv/skin.slint";

export component SkinHome inherits Window {
    title: "RustTV — Classic Home Pro";
    background: #0F1115;
    preferred-width: 1280px;
    preferred-height: 720px;

    property <length> u: min(root.width / 1920, root.height / 1080);

    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            RustTV.key(event.text, true, event.repeat) ? accept : reject
        }
        key-released(event) => {
            RustTV.key(event.text, false, false) ? accept : reject
        }
    }

    // Dynamic ambient hero colour glow driven by the focused app's tint.
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: @radial-gradient(
            circle,
            RustTV.hero-color.with-alpha(RustTV.i0 == 0 ? 0.42 : 0.18) 0%,
            RustTV.hero-color.with-alpha(RustTV.i0 == 0 ? 0.14 : 0.05) 48%,
            #0F111500 80%
        );
    }

    // Top-left clock.
    Text {
        x: 96 * u;
        y: 48 * u;
        text: RustTV.clock-text;
        font-size: 38 * u;
        font-weight: 500;
        color: #F2F4F8E0;
    }

    // Top-right circular quick controls (Glow toggle + Settings).
    HorizontalLayout {
        x: parent.width - self.preferred-width - 96 * u;
        y: 44 * u;
        width: self.preferred-width;
        height: 60 * u;
        spacing: 16 * u;

        // Glow intensity toggle
        Rectangle {
            property <bool> is-focused: RustTV.i1 == 1 && RustTV.i2 == 0;
            width: 60 * u;
            height: 60 * u;
            border-radius: 30 * u;
            background: is-focused ? #F2F4F8 : #FFFFFF18;
            border-width: is-focused ? 2 * u : 1 * u;
            border-color: is-focused ? #FFFFFF : #FFFFFF30;
            animate background { duration: 140ms; easing: ease-out; }
            Path {
                x: 16 * u;
                y: 16 * u;
                width: 28 * u;
                height: 28 * u;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 12 3 L 12 5 M 12 19 L 12 21 M 4.93 4.93 L 6.34 6.34 M 17.66 17.66 L 19.07 19.07 M 3 12 L 5 12 M 19 12 L 21 12 M 4.93 19.07 L 6.34 17.66 M 17.66 6.34 L 19.07 4.93 M 12 8 A 4 4 0 1 0 12 16 A 4 4 0 1 0 12 8 Z";
                stroke: parent.is-focused ? #0F1115 : #F2F4F8;
                stroke-width: 2 * u;
                stroke-line-cap: round;
                fill: transparent;
            }
            TouchArea { clicked => { RustTV.action("glow", ""); } }
        }

        // Settings
        Rectangle {
            property <bool> is-focused: RustTV.i1 == 1 && RustTV.i2 == 1;
            width: 60 * u;
            height: 60 * u;
            border-radius: 30 * u;
            background: is-focused ? #F2F4F8 : #FFFFFF18;
            border-width: is-focused ? 2 * u : 1 * u;
            border-color: is-focused ? #FFFFFF : #FFFFFF30;
            animate background { duration: 140ms; easing: ease-out; }
            Path {
                x: 16 * u;
                y: 16 * u;
                width: 28 * u;
                height: 28 * u;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 9 3 L 8.4 5.4 L 6.4 6.6 L 4 6 L 2 9.5 L 3.8 11 L 3.8 13 L 2 14.5 L 4 18 L 6.4 17.4 L 8.4 18.6 L 9 21 L 15 21 L 15.6 18.6 L 17.6 17.4 L 20 18 L 22 14.5 L 20.2 13 L 20.2 11 L 22 9.5 L 20 6 L 17.6 6.6 L 15.6 5.4 L 15 3 Z M 12 8.8 A 3.2 3.2 0 1 0 12 15.2 A 3.2 3.2 0 1 0 12 8.8 Z";
                stroke: parent.is-focused ? #0F1115 : #F2F4F8;
                stroke-width: 2 * u;
                stroke-line-cap: round;
                stroke-line-join: round;
                fill: transparent;
            }
            TouchArea { clicked => { RustTV.action("settings", ""); } }
        }
    }

    // Focused app title above the grid.
    Text {
        x: 96 * u;
        y: 186 * u;
        width: parent.width - 192 * u;
        text: RustTV.hero-title;
        font-size: 58 * u;
        font-weight: 500;
        color: #FFFFFF;
        overflow: elide;
    }

    // 4-column scrolling app card grid.
    Rectangle {
        x: 84 * u;
        y: 286 * u;
        width: parent.width - 168 * u;
        height: parent.height - 320 * u;
        clip: true;

        property <length> pad: 12 * u;
        property <length> gap: 32 * u;
        property <length> card-w: (self.width - 2 * self.pad - 3 * self.gap) / 4;
        property <length> card-h: 248 * u;

        Rectangle {
            x: 0;
            y: -RustTV.i4 * (parent.card-h + parent.gap);
            width: parent.width;
            height: 4000 * u;
            animate y { duration: 180ms; easing: cubic-bezier(0.2, 0.7, 0.2, 1.0); }

            for tile[i] in RustTV.tiles: Rectangle {
                property <bool> is-focused: RustTV.i1 == 0 && i == RustTV.focused-index;
                property <int> gcol: mod(i, 4);
                property <int> grow: floor(i / 4);
                property <float> sc: is-focused ? 1.05 : 1.0;
                width: parent.parent.card-w * sc;
                height: parent.parent.card-h * sc;
                x: parent.parent.pad + gcol * (parent.parent.card-w + parent.parent.gap) - (self.width - parent.parent.card-w) / 2;
                y: parent.parent.pad + grow * (parent.parent.card-h + parent.parent.gap) - (self.height - parent.parent.card-h) / 2;
                border-radius: 22 * u;
                background: tile.tint.alpha > 0 ? tile.tint : #1A1E26;
                border-width: is-focused ? 3.5 * u : 1 * u;
                border-color: is-focused ? #FFFFFF : #FFFFFF1C;
                animate width, height, x, y { duration: 160ms; easing: cubic-bezier(0.2, 0.7, 0.2, 1.0); }

                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    border-radius: parent.border-radius;
                    clip: true;
                    Image {
                        x: tile.kind == 1 ? (parent.width - 112 * u) / 2 : 0px;
                        y: tile.kind == 1 ? (parent.height - 112 * u) / 2 : 0px;
                        width: tile.kind == 1 ? 112 * u : parent.width;
                        height: tile.kind == 1 ? 112 * u : parent.height;
                        source: tile.image;
                        image-fit: tile.kind == 1 ? contain : cover;
                    }
                }
                // Running indicator pill at bottom-right.
                if tile.running: Rectangle {
                    x: parent.width - 24 * u;
                    y: parent.height - 24 * u;
                    width: 12 * u;
                    height: 12 * u;
                    border-radius: 6 * u;
                    background: #FFFFFFEE;
                }
                TouchArea { clicked => { RustTV.tile-clicked(i, false); } }
            }
        }
    }
}
